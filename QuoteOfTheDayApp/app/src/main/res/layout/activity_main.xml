<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✦  ✧  ✦  ✧  ✦  ✧  ✦"
            android:textColor="#3D3D6B"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daily Inspiration"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#E8E8FF"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.05"/>

        <TextView
            android:id="@+id/textViewDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#6B6B9E"
            android:layout_marginTop="4dp"/>

        <View
            android:layout_width="60dp"
            android:layout_height="2dp"
            android:background="#4A4AFF"
            android:layout_marginTop="16dp"/>

        <!-- Language Selector -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#13132B">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:gravity="center">

                <Button
                    android:id="@+id/btnEnglish"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="English"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="#4A4AFF"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btnHindi"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="हिंदी"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="#13132B"
                    android:textColor="#8888CC"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btnMarathi"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="मराठी"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="#13132B"
                    android:textColor="#8888CC"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Quote Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="16dp"
            app:cardBackgroundColor="#13132B">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❝"
                    android:textSize="56sp"
                    android:textColor="#4A4AFF"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/textViewQuote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="19sp"
                    android:textColor="#E8E8FF"
                    android:textStyle="italic"
                    android:lineSpacingMultiplier="1.7"
                    android:fontFamily="serif"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2A2A5A"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="24dp"
                        android:layout_height="2dp"
                        android:background="#4A4AFF"/>

                    <TextView
                        android:id="@+id/textViewAuthor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#8888CC"
                        android:textStyle="bold"
                        android:layout_marginStart="10dp"/>

                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Button Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#4A4AFF">

                <Button
                    android:id="@+id/buttonNew"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="🔀 New Quote"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="@android:color/transparent"/>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#C2185B">

                <Button
                    android:id="@+id/buttonFavorite"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="❤️ Favorite"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="@android:color/transparent"/>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Button Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#00838F">

                <Button
                    android:id="@+id/buttonShare"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="📤 Share"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="@android:color/transparent"/>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#E65100">

                <Button
                    android:id="@+id/buttonViewFavorites"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="⭐ Favorites"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="@android:color/transparent"/>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Copy Button -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#13132B">

            <Button
                android:id="@+id/buttonCopy"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="📋 Copy Quote"
                android:textColor="#8888FF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="@android:color/transparent"/>

        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✦  ✧  ✦  ✧  ✦  ✧  ✦"
            android:textColor="#3D3D6B"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</ScrollView>